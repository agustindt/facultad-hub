{
  "name": "facultad-hub-backend",
  "version": "0.1.0",
  "description": "API del hub del vault de Facultad",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-lines=96 --test-coverage-branches=80 --test-coverage-include=dominio.js --test-coverage-include=db/almacen.js --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info test/*.test.js"
  },
