# Copiá este archivo a .env y completá los valores.
# El .env NO se commitea: está en .gitignore. Este sí.

# --- Base de datos ---
DB_NAME=hub
DB_USER=hub
DB_PASSWORD=cambiame

# --- Dónde está tu vault de Obsidian, en TU máquina ---
# Es un bind mount: el backend lo ve en /vault adentro del contenedor.
VAULT_PATH=/Users/agusditomaso/Documents/Facultad

# --- Puerto en el que abrís el hub ---
PUERTO_WEB=8080

# --- Sólo para docker-compose.registry.yml ---
GH_USER=agustindt
TAG=v0.1.0
