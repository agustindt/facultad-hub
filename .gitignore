# Datos locales: clave de API, token de GitHub, eventos propios, calendario de
# repaso, registro de uso de IA. NUNCA se versionan.
datos/
backend/datos/

# Secretos de compose. El .env.example SÍ va.
.env

node_modules/
coverage/
playwright-report/
test-results/
.DS_Store
*.log

# salidas crudas de evidencia, las capturas son los png
img/*.txt
img/*.json
img/*.err

# Terraform: el estado tiene la clave de la base, y .terraform es cache local.
# El estado de este repo vive en $HOME/tfstate, fuera del workspace.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
!infra/*.tfvars.example
infra/crash.log
infra/crash.*.log
